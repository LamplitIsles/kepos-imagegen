{
  "name": "@lamplitisles/pi-imagegen",
  "version": "0.1.0",
  "description": "Kepos bridge image generation extension for Pi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamplitisles/kepos-imagegen.git",
    "directory": "packages/pi-imagegen"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "kepos",
    "image-generation"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.19"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.19"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --root ../.. packages/pi-imagegen/test"
  }
}
